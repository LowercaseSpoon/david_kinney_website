.page-panel
  #videoCarousel.carousel.slide.media-carousel data-bs-ride="false"
    .carousel-indicators
      button.active type="button" data-bs-target="#videoCarousel" data-bs-slide-to="0" aria-current="true" aria-label="Derrick"
      button type="button" data-bs-target="#videoCarousel" data-bs-slide-to="1" aria-label="Supplier"
      button type="button" data-bs-target="#videoCarousel" data-bs-slide-to="2" aria-label="Masashi Yasuda"
      button type="button" data-bs-target="#videoCarousel" data-bs-slide-to="3" aria-label="Customer"
      button type="button" data-bs-target="#videoCarousel" data-bs-slide-to="4" aria-label="Francine"

    .carousel-inner
      .carousel-item.active
        h2.text-center= I18n.t("voice_over_roles.derrick")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/8IsrUioKIjw?si=hFZbURhErL1gO7iv" title="Character Role - Derrick" allowfullscreen=""

      .carousel-item
        h2.text-center= I18n.t("voice_over_roles.supplier")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/8MS7ZPcKsDw" title="Character Role - Supplier" allowfullscreen=""

      .carousel-item
        h2.text-center= I18n.t("voice_over_roles.masashi_yasuda")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/Oukon1DAjos" title="Character Role - Masashi Yasuda" allowfullscreen=""

      .carousel-item
        h2.text-center= I18n.t("voice_over_roles.customer")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/6ElNhVnpI_o?si=b-Cqk4aMHo9_UBi0" title="Character Role - Customer" allowfullscreen=""

      .carousel-item
        h2.text-center= I18n.t("voice_over_roles.francine")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/S9F5t3bFbeQ?si=K5pLfgdWUB3Ep8T1" title="Character Role - Francine" allowfullscreen=""

    button.carousel-control-prev type="button" data-bs-target="#videoCarousel" data-bs-slide="prev"
      span.carousel-control-prev-icon aria-hidden="true"
      span.visually-hidden Previous
    button.carousel-control-next type="button" data-bs-target="#videoCarousel" data-bs-slide="next"
      span.carousel-control-next-icon aria-hidden="true"
      span.visually-hidden Next
