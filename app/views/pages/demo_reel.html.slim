.page-panel
  #demoReelCarousel.carousel.slide.media-carousel data-bs-ride="false"
    .carousel-indicators
      button.active type="button" data-bs-target="#demoReelCarousel" data-bs-slide-to="0" aria-current="true" aria-label="Commercial Demo 2.0"
      button type="button" data-bs-target="#demoReelCarousel" data-bs-slide-to="1" aria-label="Demo Reel"

    .carousel-inner
      .carousel-item.active
        h2.text-center= I18n.t("commercial_reel.new_title")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/5PE3DR2GBq8?si=FjqFvk0s6RMxkkPR" title="Commercial Demo 2.0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""

      .carousel-item
        h2.text-center= I18n.t("demo_reel.new_title")
        .ratio.ratio-16x9.rounded.overflow-hidden
          iframe src="https://www.youtube.com/embed/FfWOmnvI5j0?si=xTiCoXeXITMvQAPg" title="Demo Reel" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""

    button.carousel-control-prev type="button" data-bs-target="#demoReelCarousel" data-bs-slide="prev"
      span.carousel-control-prev-icon aria-hidden="true"
      span.visually-hidden Previous
    button.carousel-control-next type="button" data-bs-target="#demoReelCarousel" data-bs-slide="next"
      span.carousel-control-next-icon aria-hidden="true"
      span.visually-hidden Next
