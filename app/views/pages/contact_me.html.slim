- content_for :scripts do
  = javascript_pack_tag "contact_me_form"

.page-panel.page-panel--narrow
  .follow-me.text-center
    h2.h4.follow-title Connect With Me
    .social-links
      a.social-icon.twitter-hover href="https://twitter.com/DavidKinney101" title="Follow on Twitter" target="_blank" rel="noopener"
        = image_tag "logo-black.png", alt: "Twitter", class: "twitter"
        span.social-label X/Twitter
      a.social-icon.discord-hover href="https://discord.com/channels/dkvo125" title="Join me on Discord" target="_blank" rel="noopener"
        = image_tag "discord-logo-black.png", alt: "Discord", class: "discord"
        span.social-label Discord
      a.social-icon.bluesky-hover href="https://bsky.app/profile/davidkinneyjrvo.bsky.social" title="Follow on BlueSky" target="_blank" rel="noopener"
        = image_tag "blue_sky_butterfly.png", alt: "BlueSky", class: "bluesky"
        span.social-label BlueSky
      a.social-icon.imdb-hover href="https://pro.imdb.com/name/nm15856497?s=1ccb7783-7885-df43-17b6-4fe95b062e95&site_preference=normal" title="IMDB" target="_blank" rel="noopener"
        = image_tag "imdb-branding.png", alt: "IMDB", class: "imdb"
        span.social-label IMDB
      a.social-icon.instagram-hover href="https://www.instagram.com/davidkinneyjrvo?igsh=MzRlODBiNWFlZA==" title="Follow on Instagram" target="_blank" rel="noopener"
        = image_tag "instagram-logo-2.webp", alt: "Instagram", class: "instagram"
        span.social-label Instagram

  .contact-form
    h2.h4.mb-3 Contact Me
    form
      label for="name" Name
      input.form-control type="text" id="name" name="name" required="required"

      label for="email" Email
      input.form-control type="email" id="email" name="email" required="required"

      label for="message" Message
      textarea.form-control id="message" name="message" rows="5" required="required"

      button.btn.btn-submit type="submit" Submit
