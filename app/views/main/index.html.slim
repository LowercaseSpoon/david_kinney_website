- content_for :body_class, "home-page video-playing"
- content_for :overlay do
  = video_tag "video-intro.mp4", class: "background-video", autoplay: true, muted: true, playsinline: true, id: "intro-video"
- content_for :scripts do
  = javascript_pack_tag "homepage"

.home-hero
  .home-hero__brand
    h1.home-hero__name= I18n.t("name")
    p.home-hero__subtitle= I18n.t("voice_actor")
    .home-hero__actions
      = link_to I18n.t("nav_bar.demo_reel"), demo_reel_path, class: "btn-dk"
      = link_to I18n.t("nav_bar.contact_me"), contact_me_path, class: "btn-dk btn-dk--outline"
