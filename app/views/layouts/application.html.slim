doctype html
html lang="en"
  head
    title= content_for?(:title) ? yield(:title) : "David Kinney VO"
    = favicon_link_tag "favicon.png", rel: "icon", type: "image/png"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    = csrf_meta_tags
    = stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", media: "all"
    = stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css", media: "all"
    = stylesheet_link_tag "application", media: "all"
    = yield :head
    = javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"

  body class=(content_for?(:body_class) ? content_for(:body_class) : nil)
    = yield :overlay
    = render "shared/navbar"
    main.site-main
      = yield
    = render "shared/page_background"
    = yield :scripts
